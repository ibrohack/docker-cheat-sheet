# Editor and IDE configuration stays local
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating system files
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Local environment files and secrets
# (the cheat sheet shows docker run --env-file .env, so they are easy to create here by accident)
.env
.env.*
!.env.example

# Database dumps, backups and exports
# Running the Odoo, PostgreSQL and volume rows from this folder writes these files here.
# They hold customer data and password hashes and must never be committed.
# Use git add -f if you ever need to track one on purpose.
*.sql
*.sql.gz
*.dump
*.zip
*.tar
*.tar.gz
*.tgz
filestore_*/
backups/

# Node tooling (the site has no dependencies; this covers local linting or helper scripts)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs and temporary files
*.log
*.tmp
*.bak
